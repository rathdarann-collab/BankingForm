    private JTextField txtaccount, txtname, txtAmount, txtbalance;
    private JButton btnAdd, btnRemove, btnDeposit, btnWithdraw, btnClear,btnUpdate,btnSearch;
    private JButton btnFirst, btnPrevious, btnNext, btnLast;
    private DefaultTableModel model;
    private JTable table;
    private final ArrayList<BankingModel> list = new ArrayList<>();
    private int currentIndex = -1;

    private static final String URL      = "jdbc:mysql://localhost:3306/bankingform";
    private static final String USER     = "root";
    private static final String PASSWORD = "Az687133";

