    public BankingForm() {
        conn = getConnection();
        if (conn == null) {
            JOptionPane.showMessageDialog(this,
                    "Could not connect to the database.\nMake sure MySQL is running and banking exists.",
                    "Database Error", JOptionPane.ERROR_MESSAGE);
        }

        //panel1
        JPanel p1 = new JPanel();
        JLabel title = new JLabel("Banking System");
        title.setFont(new Font("Arial", Font.BOLD, 20));
        p1.add(title);

        //panel2
        JPanel p2 = new JPanel(new GridLayout(4, 2, 5, 5));
        p2.setBorder(BorderFactory.createEmptyBorder(10, 20, 10, 20));
        p2.add(new JLabel("Account No:"));
        p2.add(txtaccount = new JTextField());
        p2.add(new JLabel("Name:"));
        p2.add(txtname    = new JTextField());
        p2.add(new JLabel("Amount:"));
        p2.add(txtAmount    = new JTextField());
        p2.add(new JLabel("Balance:"));
        p2.add(txtbalance = new JTextField());
        txtbalance.setEditable(false); // balance is only changed via Deposit/Withdraw once an account exi

        // whatever the user types into Amount is mirrored into Balance
        txtAmount.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
            public void insertUpdate(javax.swing.event.DocumentEvent e)  { txtbalance.setText(txtAmount.getText()); }
            public void removeUpdate(javax.swing.event.DocumentEvent e)  { txtbalance.setText(txtAmount.getText()); }
            public void changedUpdate(javax.swing.event.DocumentEvent e) { txtbalance.setText(txtAmount.getText()); }
