    // LOAD ALL ACCOUNTS FROM DATABASE
    private void loadDataFromDB() {
        list.clear();
        model.setRowCount(0);

        if (conn == null) return;

        String sql = "Banking , name, amount, balance FROM accounts ORDER BY account_no";
        try (Statement st = conn.createStatement();
             ResultSet rs = st.executeQuery(sql)) {

            while (rs.next()) {
                BankingModel b = new BankingModel(
                        rs.getString("account_no"),
                        rs.getString("name"),
                        rs.getString("amount"),
                        rs.getDouble("balance"));
                list.add(b);
                model.addRow(new Object[]{
                        b.getAccountNo(), b.getName(), b.getAmount(),
                        String.format("%.2f", b.getBalance())
                });
            }
        } catch (SQLException ex) {
            JOptionPane.showMessageDialog(this, "Error loading accounts: " + ex.getMessage(),
                    "Database Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    //add
    private BankingModel getAccountInput() {
        String account = txtaccount.getText().trim();
        String name    = txtname.getText().trim();
        String amount    = txtAmount.getText().trim();
        String balanceStr = txtbalance.getText().trim();
        if (balanceStr.isEmpty()) balanceStr = "0";

        if (account.isEmpty() || name.isEmpty() || amount.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please fill in Account No, Name and Type!");
            return null;
        }

        double balance;
        try { balance = Double.parseDouble(balanceStr); }
        catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Balance must be a number!");
            return null;
        }

        return new BankingModel(account, name, amount, balance);
    }

    //clear
    private void clearFields() {
        txtaccount.setText("");
        txtname.setText("");
        txtAmount.setText("");
        txtbalance.setText("");
        table.clearSelection();
        txtaccount.requestFocus();
    }

    // fill
    private void fillFieldsFromIndex(int index) {
        if (index < 0 || index >= list.size()) return;
        BankingModel b = list.get(index);
        txtaccount.setText(b.getAccountNo());
        txtname.setText(b.getName());
        txtAmount.setText(b.getAmount());
        txtbalance.setText(String.format("%.2f", b.getBalance()));
        table.setRowSelectionInterval(index, index);
        table.scrollRectToVisible(table.getCellRect(index, 0, true));
    }

    //select
    private BankingModel getSelectedAccount() {
        if (currentIndex < 0 || currentIndex >= list.size()) {
            JOptionPane.showMessageDialog(this, "Please select an account first!");
            return null;
        }
        return list.get(currentIndex);
    }

    //action
    @Override
    public void actionPerformed(ActionEvent e) {

        if (conn == null && e.getSource() != btnFirst && e.getSource() != btnPrevious
                && e.getSource() != btnNext && e.getSource() != btnLast) {
            JOptionPane.showMessageDialog(this, "No database connection. Cannot perform this action.",
                    "Database Error", JOptionPane.ERROR_MESSAGE);
            return;
        }

        //add
        if (e.getSource() == btnAdd) {
            txtbalance.setEditable(true);
            BankingModel account = getAccountInput();
            txtbalance.setEditable(false);
            if (account == null) return;

            String sql = "INSERT INTO accounts (account_no, name, amount, balance) VALUES (?, ?, ?, ?)";
            try (PreparedStatement ps = conn.prepareStatement(sql)) {
                ps.setString(1, account.getAccountNo());
                ps.setString(2, account.getName());
                ps.setString(3, account.getAmount());
                ps.setDouble(4, account.getBalance());
                ps.executeUpdate();

                loadDataFromDB();
                JOptionPane.showMessageDialog(this, "Account added successfully!");
                clearFields();
            } catch (SQLIntegrityConstraintViolationException dup) {
                JOptionPane.showMessageDialog(this, "Account number already exists!");
            } catch (SQLException ex) {
                JOptionPane.showMessageDialog(this, "Error adding account: " + ex.getMessage(),
                        "Database Error", JOptionPane.ERROR_MESSAGE);
            }
        }

        //remove
        if (e.getSource() == btnRemove) {
            BankingModel selected = getSelectedAccount();
            if (selected == null) return;

            int confirm = JOptionPane.showConfirmDialog(this,
                    "Remove account \"" + selected.getAccountNo() + "\"?",
                    "Confirm Remove", JOptionPane.YES_NO_OPTION);
            if (confirm != JOptionPane.YES_OPTION) return;

            String sql = "DELETE FROM accounts WHERE account_no = ?";
            try (PreparedStatement ps = conn.prepareStatement(sql)) {
                ps.setString(1, selected.getAccountNo());
                ps.executeUpdate();

                currentIndex = -1;
                loadDataFromDB();
                clearFields();
                JOptionPane.showMessageDialog(this, "Account removed!");
            } catch (SQLException ex) {
                JOptionPane.showMessageDialog(this, "Error removing account: " + ex.getMessage(),
                        "Database Error", JOptionPane.ERROR_MESSAGE);
            }
            //clear
        } else if (e.getSource() == btnClear) {
            clearFields();
        }

        //deposit
        if (e.getSource() == btnDeposit) {
            BankingModel selected = getSelectedAccount();
            if (selected == null) return;

            String input = JOptionPane.showInputDialog(this,
                    "Deposit amount for account " + selected.getAccountNo() + ":");
            if (input == null) return; // cancelled

            double amount;
            try {
                amount = Double.parseDouble(input.trim());
            } catch (NumberFormatException ex) {
                JOptionPane.showMessageDialog(this, "Amount must be a number!");
                return;
            }
            if (amount <= 0) {
                JOptionPane.showMessageDialog(this, "Amount must be greater than zero!");
                return;
            }

            String sql = "UPDATE accounts SET balance = balance + ? WHERE account_no = ?";
            try (PreparedStatement ps = conn.prepareStatement(sql)) {
                ps.setDouble(1, amount);
                ps.setString(2, selected.getAccountNo());
                ps.executeUpdate();

                String accountNo = selected.getAccountNo();
                loadDataFromDB();
                selectByAccountNo(accountNo);
                JOptionPane.showMessageDialog(this, "Deposit successful!");
            } catch (SQLException ex) {
                JOptionPane.showMessageDialog(this, "Error depositing: " + ex.getMessage(),
                        "Database Error", JOptionPane.ERROR_MESSAGE);
            }
        }
        //update
        else if(e.getSource() == btnUpdate) {
            BankingModel selectedAccount = getSelectedAccount();
            if (selectedAccount == null) return;

            String newName = txtname.getText().trim();
            String newAmount = txtAmount.getText().trim();

            if (newName.isEmpty() || newAmount.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Please fill in Name and Amount!");
                return;
            }

            String sql = "UPDATE accounts SET name = ?, amount = ? WHERE account_no = ?";
            try (PreparedStatement ps = conn.prepareStatement(sql)) {
                ps.setString(1, newName);
                ps.setString(2, newAmount);
                ps.setString(3, selectedAccount.getAccountNo());
                ps.executeUpdate();
                String accountNo = selectedAccount.getAccountNo();
                loadDataFromDB();
                selectByAccountNo(accountNo);
                JOptionPane.showMessageDialog(this, "Account updated successfully!");
            } catch (SQLException ex) {
                JOptionPane.showMessageDialog(this, "Error updating account: " + ex.getMessage(),
                        "Database Error", JOptionPane.ERROR_MESSAGE);
            }
        }

        if (e.getSource() == btnUpdate) {
            String accountNo = txtaccount.getText().trim();
            String name = txtname.getText().trim();

        } else if (e.getSource() == btnSearch) {

            String accountNo = txtaccount.getText().trim();

            if (accountNo.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Enter Account Number!");
                return;
            }

            String sql = "SELECT * FROM accounts WHERE account_no = ?";

            try (PreparedStatement ps = conn.prepareStatement(sql)) {

                ps.setString(1, accountNo);

                ResultSet rs = ps.executeQuery();

                if (rs.next()) {

                    txtname.setText(rs.getString("name"));
                    txtAmount.setText(rs.getString("amount"));
                    txtbalance.setText(String.valueOf(rs.getDouble("balance")));

                } else {

                    JOptionPane.showMessageDialog(this,
                            "Account not found!");

                    clearFields();

                }

            } catch (SQLException ex) {

                JOptionPane.showMessageDialog(this,
                        ex.getMessage());

            }
        }
        //withdraw
        if (e.getSource() == btnWithdraw) {
            BankingModel selected = getSelectedAccount();
            if (selected == null) return;

            String input = JOptionPane.showInputDialog(this,
                    "Withdraw amount for account " + selected.getAccountNo()
                            + " (current balance: " + String.format("%.2f", selected.getBalance()) + "):");
            if (input == null) return; // cancelled

            double amount;
            try { amount = Double.parseDouble(input.trim()); }
            catch (NumberFormatException ex) {
                JOptionPane.showMessageDialog(this, "Amount must be a number!");
                return;
            }
            if (amount <= 0) {
                JOptionPane.showMessageDialog(this, "Amount must be greater than zero!");
                return;
            }
            if (amount > selected.getBalance()) {
                JOptionPane.showMessageDialog(this, "Insufficient balance!");
                return;
            }

            String sql = "UPDATE accounts SET balance = balance - ? WHERE account_no = ?";
            try (PreparedStatement ps = conn.prepareStatement(sql)) {
                ps.setDouble(1, amount);
                ps.setString(2, selected.getAccountNo());
                ps.executeUpdate();

                String accountNo = selected.getAccountNo();
                loadDataFromDB();
                selectByAccountNo(accountNo);
                JOptionPane.showMessageDialog(this, "Withdrawal successful!");
            } catch (SQLException ex) {
                JOptionPane.showMessageDialog(this, "Error withdrawing: " + ex.getMessage(),
                        "Database Error", JOptionPane.ERROR_MESSAGE);
            }
        }

        //tofirst
        if (e.getSource() == btnFirst) {
            if (list.isEmpty()) return;
            currentIndex = 0;
            fillFieldsFromIndex(currentIndex);
        }

        //previous
        if (e.getSource() == btnPrevious) {
            if (list.isEmpty()) return;
            if (currentIndex <= 0) {
                JOptionPane.showMessageDialog(this, "This is already the first record!");
                currentIndex = 0;
            } else {
                currentIndex--;
            }
            fillFieldsFromIndex(currentIndex);
        }

        //next
        if (e.getSource() == btnNext) {
            if (list.isEmpty()) return;
            if (currentIndex >= list.size() - 1) {
                JOptionPane.showMessageDialog(this, "This is already the last record!");
                currentIndex = list.size() - 1;
            } else {
                currentIndex++;
            }
            fillFieldsFromIndex(currentIndex);
        }

        //last
        if (e.getSource() == btnLast) {
            if (list.isEmpty()) return;
            currentIndex = list.size() - 1;
            fillFieldsFromIndex(currentIndex);
        }
    }

    // Re-select a row by account number after a reload (keeps navigation position stable)
    private void selectByAccountNo(String accountNo) {
        for (int i = 0; i < list.size(); i++) {
            if (list.get(i).getAccountNo().equals(accountNo)) {
                currentIndex = i;
                fillFieldsFromIndex(i);
                return;
            }
        }
    }
    public static void main(String[] args) {
        SwingUtilities.invokeLater(BankingForm::new);
    }
}
